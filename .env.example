APP_NAME=bloodConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost

# ── Database (single unified DB for all 3 members) ───────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bloodconnect
DB_USERNAME=root
DB_PASSWORD=

# ── Mail (for Rameeza's NID verification & tracking emails) ──
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@bloodconnect.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── Admin credentials (for Rameeza's tracking portal) ────────
ADMIN_PASSWORD=hospital123
DONOR_EMAIL=donor@example.com
REQUESTER_EMAIL=requester@example.com

# ── Google Maps (optional, for Jaky's route calculator) ───────
GOOGLE_DIRECTIONS_API_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=debug
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
